# نمونه فایل متغیرهای محیطی — این فایل را به .env کپی کنید و مقدارها را تنظیم کنید.
# فایل .env واقعی هرگز در git قرار نمی‌گیرد (در .gitignore آمده است).
# اولویت مقدارها: متغیر محیطی > فایل data/config/settings.json > مقادیر پیش‌فرض کد

# آدرس سرویس Ollama
PERSONAL_AGENT_OLLAMA_URL=http://127.0.0.1:11434

# مدل پیش‌فرض (باید با `ollama list` نصب شده باشد)
PERSONAL_AGENT_MODEL=qwen3:8b

# زبان رابط کاربری: fa | en
PERSONAL_AGENT_LANGUAGE=fa

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
PERSONAL_AGENT_LOG_LEVEL=INFO
